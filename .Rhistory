output <- purrr::map(2019:2022, safely(function(.year){
data <- isd(usaf = 654420, wban = "99999", year = .year, force = T, parallel = T, cores = 7)
data <- data %>%
mutate(temperature = as.numeric(temperature)/10,
date = ymd(date),
year = year(date),
month = month(date),
day = day(date)) %>%
select(date, temperature, year, month, day) %>%
filter(temperature < 900)
return(data)
}))
output <- purrr::map(output, function(.x){
.x$results
}) %>%
bind_rows()
